{
  "manifest_version": 3,
  "name": "Orbit",
  "version": "1.0.0",
  "description": "Everything in your browser, one hover away.",
  "permissions": ["storage", "tabs", "sessions"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Orbit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Turn Orbit on or off for the current site"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "logo.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
